# Core paths and credential encryption. When AI_USAGE_CREDENTIAL_KEY is unset,
# ai-usage creates a chmod-0600 key at ~/.ai-usage/credential.key.
AI_USAGE_HOME=~/.ai-usage
AI_USAGE_CREDENTIAL_KEY=
AI_USAGE_CREDENTIAL_KEY_FILE=

# Backend Sentry/Bugsink. Empty DSN disables reporting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ENABLE_SAMPLE_ROUTES=0

# Frontend Sentry/Bugsink. This is intentionally independent from SENTRY_DSN.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Optional build-only sourcemap upload credentials. Never VITE_-prefix secrets.
BUILD_BUGSINK_URL=
BUILD_BUGSINK_AUTH_TOKEN=
BUILD_BUGSINK_PROJECT_SLUG=
